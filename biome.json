{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!.source",
      "!content/docs/*/*.md",
      "!content/docs/*/changelog",
      "!content/docs/*/readme.mdx",
      "!lib/community.json",
      "!lib/roadmap-issues.json",
      "!lib/roadmap-requests.json",
      "!lib/world-map.json",
      "!lib/built-with.json",
      "!scripts/data",
      "!content/docs/*/contribute",
      "!components/desktop/thaw-panes.json",
      "!components/desktop/thaw-items.json",
      "!reference",
      "!public"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
