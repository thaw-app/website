{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "sync": "node --env-file-if-exists=.env.local scripts/sync-docs.mjs",
    "sync:content": "node --env-file-if-exists=.env.local scripts/sync-docs.mjs --content",
    "build": "bun run sync && next build",
    "dev": "bun run sync:content && next dev",
    "start": "next start",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "biome check",
    "test": "bun test scripts lib",
    "test:e2e": "playwright test",
    "format": "biome format --write"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.81",
    "fumadocs-core": "16.16.2",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.16.2",
    "lucide-react": "^1.50.0",
    "mermaid": "^12.1.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
