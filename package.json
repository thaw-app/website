{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "sync": "node --env-file-if-exists=.env.local scripts/sync-docs.mjs",
    "sync:content": "node --env-file-if-exists=.env.local scripts/sync-docs.mjs --content",
    "build": "bun run sync && next build",
    "dev": "bun run sync:content && next dev",
    "start": "next start",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "biome check",
    "test": "bun test scripts lib",
    "test:e2e": "playwright test",
    "format": "biome format --write"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.81",
    "cobe": "2.0.1",
    "fumadocs-core": "16.17.4",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.4",
    "lucide-react": "^1.57.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pele": "1.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
